# ============================================================================
# UNIFIED RTRADER WEB & MULTIBOT ECOSYSTEM CONFIGURATION TEMPLATE (.env.example)
# ============================================================================

# ============================================================================
# DEGEN LAUNCHPAD ENVIRONMENT TEMPLATE
# ============================================================================

DATABASE_URL="postgresql://user:password@host:5432/dbname"
MASTER_VAULT_KEY="YOUR_32_BYTE_HEX_MASTER_KEY"

DRPC_API_KEY="YOUR_DRPC_API_KEY"
BASE_MAINNET_RPC="https://lb.drpc.org/ogws?network=base&key=YOUR_DRPC_API_KEY"

ARKHAM_API_KEY="YOUR_ARKHAM_API_KEY"
FIRECRAWL_API_KEY="YOUR_FIRECRAWL_API_KEY"

DAYTONA_API_URL="https://app.daytona.io/api"
DAYTONA_API_KEY="YOUR_DAYTONA_API_KEY"
DAYTONA_TARGET="eu"

REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL="https://YOUR_UPSTASH_INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"



# ============================================================================
# MULTIBOT AUTONOMOUS EXECUTION ENGINE CONFIGURATION
# ============================================================================

# Example Configuration Template for BOT-Deploy-Multi-Chain

####################################
#### AI MODEL (Brain of the Bot) ####
####################################
GOOGLE_GENERATIVE_AI_API_KEY=
BYTEDANCE_ARK_API_KEY=
BYTEDANCE_MODEL_ENDPOINT=
BYTEDANCE_BASE_URL=

####################################
#### TREND RADAR ####
####################################
FIRECRAWL_API_KEY=

####################################
#### IPFS STORAGE ####
####################################
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

####################################
#### EVM WALLET (Base / Robinhood / Arbitrum) ####
####################################
EVM_PRIVATE_KEY=
EVM_DEFAULT_CHAIN=base

BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.robinhoodchain.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

####################################
#### BANKR INTEGRATION ####
####################################
BANKR_API_KEY=
BANKR_CHAIN=base            # Options: base | robinhood | arbitrum
BANKR_QUOTE_ONLY_FEES=true
BANKR_DEGEN_MODE=true
BANKR_SIMULATE_ONLY=false

# Gas Sponsorship Policy (Fail-Closed Production Defaults)
# Note: Gas sponsorship is only available on Base Mainnet (BANKR_REQUIRE_GAS_SPONSORSHIP=true)
# For Robinhood/Arbitrum, set to false
BANKR_REQUIRE_GAS_SPONSORSHIP=true
BANKR_ALLOW_PAID_GAS_FALLBACK=false

####################################
#### TREASURY & MONETIZATION ####
####################################
TREASURY_AUTO_CLAIM_ENABLED=true
TREASURY_MIN_CLAIM_ETH=0.005
TREASURY_EVM_DESTINATION=

####################################
#### SOLANA WALLET (Pump.fun) ####
####################################
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=

####################################
#### TELEGRAM (BasedBot Sniper) ####
####################################
TELEGRAM_BOT_TOKEN=
COMMUNITY_TELEGRAM_CHANNEL=
AUTO_TELEGRAM_BROADCAST=true
BASEDBOT_CHAT_ID=@BasedOnBot
# SNIPER_ENABLED: true = jalankan snipe otomatis, false = Mode Modal Rp 0 (deploy gratis, 0 ETH buy)
SNIPER_ENABLED=true
# SNIPE_WALLET_COUNT: Jumlah sub-wallet untuk partisi buy (desentralisasi Top Holders Rick Bot)
SNIPE_WALLET_COUNT=3
SNIPE_AMOUNT_ETH=0.003
SNIPE_AMOUNT_SOL=0.05
SNIPER_MAX_SUPPLY_RATIO=0.018
SNIPE_SAFE_CAP_ETH=0.02

####################################
#### BOT BEHAVIOR ####
####################################
DEPLOY_MODE=testnet
PREFLIGHT_MIN_BALANCE_ETH=0.0
PREFLIGHT_MIN_BALANCE_SOL=0.0
TREND_SCAN_INTERVAL_MINUTES=30
MAX_DEPLOYS_PER_DAY=10
MIN_VIRAL_SCORE=70
ACTIVE_CHAINS=base,solana
ANTI_SNIPE_DELAY_MS=12000
SATURATION_CHECK_ENABLED=true

####################################
#### V4.0: CLANKER v3.1 ON-CHAIN DEPLOYER (BASE MAINNET) ####
# Deploy token via Clanker v3.1 Factory (0x2A787b2362021cC3eEa3C24C4748a6cD5B687382).
# TIDAK memerlukan API key. Operator (EVM_PRIVATE_KEY) membayar gas langsung.
# Syarat: saldo >= 0.006 ETH di Base Mainnet sebelum deploy.
####################################
# Aktifkan/nonaktifkan deployer Clanker. Default: true
CLANKER_ENABLED=true
# Dev buy yang dibundel dalam tx deploy (ETH). 0 = tidak ada dev buy.
# Jika diisi, jumlah ini (+ gas) harus tersedia di wallet.
CLANKER_DEV_BUY_ETH=0
# Persentase creator fee dari pool liquidity (0-100). Default: 40%
CLANKER_CREATOR_REWARD_PCT=40

####################################
#### V4.0: WETH WRAP UTILITY (BASE MAINNET) ####
# Gas limit untuk WETH9.deposit() (aktual ~29k, buffer ke 35k).
####################################
WETH_WRAP_GAS_LIMIT=35000

####################################
#### WEB3 DEPLOYMENT & HOSTING ####
####################################
# Vercel REST API Token for automatic static landing page deployment
VERCEL_TOKEN=
# Cloudflare Pages API credentials for multi-target edge hosting
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Root domain for autonomous vanity DNS subdomains (e.g., yourdomain.com)
ROOT_DOMAIN=

####################################
#### NEON SERVERLESS POSTGRESQL (MULTI-TENANT PER TOKEN) ####
####################################
# Serverless Postgres on AWS (Neon). Isolated cloud database per token alongside local SQLite.
NEON_DATABASE_URL=postgresql://neondb_owner:password@ep-mute-shape-ay3alze1-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_PROJECT_ID=solitary-tooth-34784156
NEON_BRANCH_ID=br-silent-feather-ayhnpy6l


